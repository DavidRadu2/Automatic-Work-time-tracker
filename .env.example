# Copy to .env and change locally. Never commit .env.
ARBETSTID_WIFI="OfficeWiFi"
ARBETSTID_TIMEZONE="UTC"
ARBETSTID_DAILY_HOURS=8
# Optional unpaid daily break, in minutes. Recorded gaps count towards this
# allowance, so a lunch break recorded with stop/start is not deducted twice.
# Leave 0 to use only explicitly recorded breaks.
ARBETSTID_BREAK_MINUTES=0
# Optional custom storage directory (keep private, never commit runtime data):
# ARBETSTID_DATA_DIR="/path/to/private/work-log"
